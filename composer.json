{
    "name": "explorin/laravel-tebot",
    "description": "Bot for notification log",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Explorin\\Tebot\\": "src/"
        },
        "files": [
            "src/helpers/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Explorin\\Tebot\\TebotServiceProvider"
            ],
            "aliases": {
                "Tebot": "Explorin\\Tebot\\Facades\\TebotFacade"
            }
        }
    }
}